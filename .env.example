# Leave the Azure values unset to run the deterministic offline extractor.
DOCAGENT_BACKEND=auto

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o

# Routing thresholds
DOCAGENT_FIELD_FLOOR=0.80
DOCAGENT_CRITICAL_FLOOR=0.92
DOCAGENT_MANUAL_APPROVAL_AMOUNT=500000

# Drift alerting
DOCAGENT_DRIFT_PSI_ALERT=0.2
DOCAGENT_AUTO_POST_DROP_ALERT=0.10

# Handling-time model used by the throughput numbers
DOCAGENT_MANUAL_SECONDS=210
DOCAGENT_REVIEW_SECONDS=90
